[application]
config/name="Frontier Command MVP"
run/main_scene="res://scenes/main.tscn"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
camera_left={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":65)]}
camera_right={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":68)]}
camera_up={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":87)]}
camera_down={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":83)]}
debug_overlay={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194332)]}
pause_game={"deadzone":0.5,"events":[Object(InputEventKey,"physical_keycode":4194305)]}

